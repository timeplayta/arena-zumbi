{
  "name": "arena-zumbi",
  "main": "online/worker.js",
  "compatibility_date": "2025-01-01",
  "assets": { "directory": "./game/public", "binding": "ASSETS", "run_worker_first": ["/ws/*", "/api/*"] },
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "Room" }, { "name": "ACCOUNTS", "class_name": "Accounts" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }, { "tag": "v2", "new_sqlite_classes": ["Accounts"] }]
}
